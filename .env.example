# Environment Variables for Live Arbitrage Bot
# Never commit this file with actual values

# Helius RPC URL (get from https://helius.dev/)
HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY"

# Bot Wallet Public Key (get from Phantom or Solana CLI)
BOT_WALLET_PUBKEY="YOUR_BOT_WALLET_PUBLIC_KEY"

# Jupiter API Key (not required for quotes, but needed for swaps)
JUPITER_API_KEY="YOUR_JUPITER_API_KEY"

# Bot Capital
BOT_CAPITAL_USD=1000